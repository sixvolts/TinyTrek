[Unit]
Description=socketcand SocketCAN-to-TCP bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bridge both CTF buses. socketcand listens on TCP 29536 by default.
ExecStart=/usr/bin/socketcand -i can0,can1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
