# TTOS CTF per-car provisioning file (§5.6).
#
# HOW TO USE: copy this file onto the FAT boot partition of the SD card as
#   ttos-provision.conf   (NOT the .example name), edit the values, and boot.
# Read ONCE on first boot, then wiped from the FAT partition and moved into the
# rootfs. Editable from any Windows/macOS/Linux laptop -- no rebuild.
#
# Format: KEY=value, one per line. '#' starts a comment. Full-line comments (like
# these) and trailing comments (VALUE  # note) are both fine -- but keep a space
# before the '#'. No quotes needed. CRLF line endings are handled automatically.
#
# A missing or malformed file makes the car FAIL LOUDLY on the console rather than
# boot with defaults, and leaves this file in place so you can fix it and reboot.

# --- identity [required] ---
TTOS_HOSTNAME=ttos-car-00
TTOS_CAR_ID=00

# --- WiFi AP (§5.3) ---
TTOS_WIFI_SSID=ttos-car-00
# WPA2: an 8..63 character passphrase, OR 64 hex digits (raw PSK). [required]
TTOS_WIFI_PSK=change-me-8to63chars
# regulatory domain [required]
TTOS_WIFI_COUNTRY=US
# NON-DFS 5GHz channel [required]: 36 40 44 48 149 153 157 161
TTOS_WIFI_CHANNEL=149
# TX power in mBm (500 = 5 dBm, low power). optional, default 500
TTOS_WIFI_TXPOWER_MBM=500

# --- Serial ops console credential (§5.5) [required] ---
# Password HASH ONLY, never plaintext. Generate on any Linux/mac box:
#   openssl passwd -6 'the-long-generated-password'      (sha512crypt, $6$...)
#   mkpasswd -m yescrypt 'the-long-generated-password'   (yescrypt, $y$...)
TTOS_CONSOLE_PW_HASH=$6$REPLACE$WITH.A.REAL.HASH.................................

# --- Optional ---
# dev SSH key for the ttos user:
#TTOS_SSH_AUTHORIZED_KEY=ssh-ed25519 AAAA... dev@laptop
# per-car static Ethernet address:
#TTOS_ETH_ADDRESS=192.168.60.13/24
