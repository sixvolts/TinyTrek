# TTOS CTF per-car provisioning file (§5.6).
#
# HOW TO USE: copy this file onto the FAT boot partition of the SD card as
#   ttos-provision.conf   (NOT the .example name), edit the values, and boot.
# Read ONCE on first boot, then wiped from the FAT partition and moved into the
# rootfs. Editable from any Windows/macOS/Linux laptop -- no rebuild.
#
# Format: KEY=value, one per line. '#' starts a comment. Full-line comments (like
# these) and trailing comments (VALUE  # note) are both fine -- but keep a space
# before the '#'. No quotes needed. CRLF line endings are handled automatically.
#
# A missing or malformed file makes the car FAIL LOUDLY on the console rather than
# boot with defaults, and leaves this file in place so you can fix it and reboot.

# --- identity [required] ---
TTOS_HOSTNAME=ttos-car-00
TTOS_CAR_ID=00

# --- WiFi AP (§5.3) ---
TTOS_WIFI_SSID=ttos-car-00
# WPA2: an 8..63 character passphrase, OR 64 hex digits (raw PSK). [required]
TTOS_WIFI_PSK=change-me-8to63chars
# regulatory domain [required]
TTOS_WIFI_COUNTRY=US
# NON-DFS 5GHz channel [required]: 36 40 44 48 149 153 157 161
TTOS_WIFI_CHANNEL=149
# TX power in mBm (500 = 5 dBm, low power). optional, default 500
TTOS_WIFI_TXPOWER_MBM=500

# --- Serial ops console credential (§5.5) [required] ---
# Password HASH ONLY, never plaintext. Generate on any Linux/mac box:
#   openssl passwd -6 'the-long-generated-password'      (sha512crypt, $6$...)
#   mkpasswd -m yescrypt 'the-long-generated-password'   (yescrypt, $y$...)
TTOS_CONSOLE_PW_HASH=$6$REPLACE$WITH.A.REAL.HASH.................................

# --- CTF challenge data [all required] ---
# Generated per car by provisioning/gen-fleet.py; fleet-table.csv is the source of
# truth and the node firmware is flashed with matching constants. DO NOT hand-edit
# these -- a firmware/provisioning mismatch presents as an unsolvable challenge, not
# as an error. Re-render with provisioning/render-fleet.py.
#
# Unlike the WiFi and console values these are NOT consumed: they are read at
# runtime on every boot from /etc/ttos/provision.src, so they must persist.

# Vehicle identity. NOT secret -- both are meant to be read over the diagnostic
# bus; that is the challenge. But do NOT print the VIN on the car's placard, or
# contestants skip the diagnostic bus entirely.
# VIN: 17 chars, valid ISO 3779 check digit, no I/O/Q. Served via DID 0xF190.
TTOS_VIN=TTKTREK13TC000001
# ECU serial: served via DID 0xF18C, EXTENDED SESSION ONLY.
TTOS_ECU_SERIAL=TT-ECU-00-00000000
# Fleet-wide salt, 32 hex chars. Not secret (it ships in the dashboard's client
# JS); provisioned rather than baked in so it can rotate without a rebuild.
TTOS_FLEET_SALT=00000000000000000000000000000000

# SECRET: CRC Data IDs, 0x0001..0xFFFE, one per motor, never transmitted. They key
# the CRC-8 on the drive frames; recovering them is Challenge 3. Must differ.
TTOS_DATAID_L=0x0000
TTOS_DATAID_R=0x0000

# SECRET: per-car unlock codes. 8 chars, first char is the challenge number, the
# rest from 23456789ABCDEFGHJKMNPQRSTVWXYZ (no 0/O/1/I/L -- these get retyped).
# The panel validates them against THIS car only, so a code shouted across the
# room is useless on another team's vehicle.
TTOS_CODE_C1=1XXXXXXX
TTOS_CODE_C2=2XXXXXXX
TTOS_CODE_C3=3XXXXXXX

# --- Optional ---
# dev SSH key for the ttos user:
#TTOS_SSH_AUTHORIZED_KEY=ssh-ed25519 AAAA... dev@laptop
# per-car static Ethernet address:
#TTOS_ETH_ADDRESS=192.168.60.13/24
