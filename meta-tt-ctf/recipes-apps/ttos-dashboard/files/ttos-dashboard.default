# TTOS CTF CAN dashboard configuration (read by the systemd unit).

# Listen address. On the car the console is served on the WiFi AP address, port 80
# (reachable only over the AP). This must match the AP address in 30-wlan-ap.network
# / the per-car provisioned value. The service retries the bind until wlan0 is up.
TTOS_DASH_ADDR=192.168.4.1:80

# Comma-separated CAN interfaces to monitor.
TTOS_DASH_IFACES=can0,can1

# Interface to SEND control frames on (the internal drive bus). EMPTY = read-only:
# the control buttons validate + log but do not transmit. Set to "can0" to enable
# live driving (control phase).
TTOS_DASH_DRIVE=

# Stepper steps per motion command (each button press / hold-repeat). Tune per car:
# straight moves and turns are separate (turns tend to over-rotate). Default 255/128.
TTOS_DASH_STEPS=255
TTOS_DASH_TURN_STEPS=128

# Battery gauge: the BMS transmits Vbat (mV, uint16 BE) on this CAN ID; the gauge
# maps battmin..battmax mV to 0..100%. Defaults suit a ~12V (M12) pack.
TTOS_DASH_BATT_ID=0x116
TTOS_DASH_BATT_MIN_MV=9000
TTOS_DASH_BATT_MAX_MV=12600
