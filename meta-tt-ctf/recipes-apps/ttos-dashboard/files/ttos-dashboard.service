[Unit]
Description=TinyTrek CTF operator console (CAN dashboard)
After=network.target systemd-networkd.service
Wants=network.target
# Order after first-boot provisioning so we read the final drive setting:
# factory/test mode enables driving (TTOS_DASH_DRIVE=can0); provisioning resets
# it to read-only. Ordering only (no Requires) -- the console still comes up if
# provisioning is skipped or fails.
After=ttos-provision.service

[Service]
EnvironmentFile=-/etc/default/ttos-dashboard
ExecStart=/usr/bin/ttos-dashboard
Restart=on-failure
RestartSec=3

# Unprivileged: a transient user with CAP_NET_RAW (AF_CAN socket) and
# CAP_NET_BIND_SERVICE (bind port 80 on the AP address).
DynamicUser=yes
# The ONLY way this service can read /etc/ttos/provision.src (640 root:ttos-secrets).
# Without it the transient user gets "permission denied" and the car serves no DIDs
# and no unlock codes -- a dead-but-healthy-looking station. Do not drop this
# without also changing how provisioning stages the identity.
SupplementaryGroups=ttos-secrets
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN

[Install]
WantedBy=multi-user.target
