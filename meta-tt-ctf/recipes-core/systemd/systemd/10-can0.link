# Deterministic CAN interface naming (§5.2).
#
# WHY THIS EXISTS: Mode A puts the two MCP2518FD controllers on two independent
# SPI buses (spi0 and spi1). Kernel probe order across separate SPI controllers
# is NOT guaranteed, so without pinning, "can0" and "can1" can swap between boots
# or between cars. This file pins the controller on SPI0 (BCM2711 fe204000.spi,
# the overlay line 'mcp251xfd,spi0-0,interrupt=25') to the name can0.
#
# [VERIFY-ON-BOARD] Two things must be confirmed on real hardware:
#   1. The exact match token. Derive it with:
#        udevadm info -q property -p /sys/class/net/can0 | grep -E 'ID_PATH|DEVPATH'
#      then set Path= to the reported ID_PATH (e.g. platform-fe204000.spi-...).
#   2. WHICH PHYSICAL SCREW TERMINAL is the internal vehicle bus. can0 MUST be the
#      internal (classic, RP2040 peers) bus. If the internal harness is wired to the
#      HAT channel on spi1 instead, swap the Path= tokens between 10-can0.link and
#      10-can1.link. This is a wiring fact, not a software default.
[Match]
Path=platform-fe204000.spi*
Driver=mcp251xfd

[Link]
Name=can0
