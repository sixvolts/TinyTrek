# can1 -- the DRIVE bus (internal vehicle bus). CLASSIC CAN 2.0, 500 kbit/s.
#
# ROLE NAMES, NOT NUMBERS: this is the vehicle bus despite the higher number.
# Verified on hardware 2026-08-01 -- both motor nodes and the BMS answer here.
# Carries the Pi heartbeat (0x100), drive commands (0x111/0x113), the BMS power
# command (0x115) and beacon (0x116), and the CTF flag frames (0x7D1/0x7D2).
#
# NO FDMode / NO DataBitRate, deliberately. Every node on this bus is classic-only
# -- the motor nodes are MCP2515, which has no CAN FD support at all. A genuine FD
# frame here is a form error to them: they go error-passive, then bus-off, and
# propulsion stops.
#
# This used to be configured FDMode=yes with a 1 Mbit data rate, which bought
# nothing (no node could use it) and left the Pi able to transmit a frame that
# would take the drivetrain offline. Leaving FD off means the controller cannot
# emit one even by mistake, so the hazard is removed by configuration rather than
# by remembering not to. The cangw policy still forwards classic frames only (no
# -X), which is now belt and braces rather than the only line of defence.
#
# The DIAG bus (can0) IS CAN FD -- that is where the 64-byte diagnostic responses
# live, and the only nodes there are contestant test adapters.
[Match]
Name=can1

[CAN]
BitRate=500000
