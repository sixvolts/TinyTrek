# Deterministic CAN interface naming (§5.2). See 10-can0.link for the full rationale.
# Pins the controller on SPI1 (BCM2711 fe215080.spi, overlay line
# 'mcp251xfd,spi1-0,interrupt=24') to the name can1 = EXTERNAL diagnostic FD bus.
#
# [VERIFY-ON-BOARD] Confirm the Path token (udevadm, see 10-can0.link) and that the
# EXTERNAL diagnostic harness is the spi1 channel. Swap tokens with 10-can0.link if not.
[Match]
Path=platform-fe215080.spi*
Driver=mcp251xfd

[Link]
Name=can1
