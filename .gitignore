# Build output — kas checks these out / creates them, never commit.
/build/
/downloads/
/sstate-cache/
/tmp/
*.lock

# Upstream layers cloned by kas into the repo root at build time. These are
# fetched fresh from a clean checkout (kas/ttos-ctf.yml is the source of truth),
# so they must never be committed.
/poky/
/meta-openembedded/
/meta-raspberrypi/
/meta-lts-mixins/

# Secrets and per-car provisioning data. NEVER commit (§4.2, §5.5, §5.6).
# WiFi SSID/PSK, console password hashes, Data IDs, flag codes are provisioning
# data, not source. Only the *.example templates below are tracked.
kas/*-secrets.yml
!kas/*-secrets.yml.example
*.provision.conf
!*.provision.conf.example
ttos-provision.conf
!ttos-provision.conf.example

# Generated CTF fleet data (provisioning/). Same policy as above: these carry
# console password hashes, CRC Data IDs, per-car unlock codes and WPA PSKs.
# gen-fleet.py's docstring says "commit the output" -- we deliberately do NOT,
# to stay consistent with the rule above. Back provisioning/ up OFF this repo;
# losing fleet-table.csv means reflashing every node with new values.
# The two scripts ARE tracked -- they are source, and render-fleet.py can
# rebuild every derived artifact from fleet-table.csv deterministically.
/provisioning/*
!/provisioning/gen-fleet.py
!/provisioning/render-fleet.py
!/provisioning/README.md

# Editor / OS cruft
*.swp
*~
.DS_Store

# Staged per-car challenge constants (SECRETS -- Data IDs and C2/C3 codes).
# build.sh copies provisioning/firmware-constants.h in at flash time.
/firmware/*/ttos-fleet.h
__pycache__/
